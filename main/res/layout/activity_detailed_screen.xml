<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edtDisplay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_5"
    tools:context=".DetailedScreen">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="BACK"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtComments" />

    <TextView
        android:id="@+id/edtComments"
        android:layout_width="212dp"
        android:layout_height="0dp"
        android:layout_marginBottom="134dp"
        android:background="@android:drawable/alert_light_frame"
        android:text="COMMENTS"
        app:layout_constraintBottom_toTopOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtQuantity"
        tools:ignore="NotSibling" />

    <Button
        android:id="@+id/btnGear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="34dp"
        android:layout_marginBottom="45dp"
        android:text="ADD GREAR"
        app:layout_constraintBottom_toTopOf="@+id/edtComments"
        app:layout_constraintEnd_toEndOf="@+id/edtComments" />

    <EditText
        android:id="@+id/edtItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        android:layout_marginBottom="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="@color/white"
        android:ems="10"
        android:inputType="text"
        android:text="ITEM NAME"
        app:layout_constraintBottom_toTopOf="@+id/edtCategory"
        app:layout_constraintEnd_toEndOf="@+id/edtCategory"
        app:layout_constraintStart_toStartOf="@+id/edtCategory"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/edtCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginBottom="57dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#F4F1F1"
        android:ems="10"
        android:inputType="text"
        android:text="CATEGORY"
        app:layout_constraintBottom_toTopOf="@+id/edtQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtItem"
        tools:ignore="TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/edtQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="154dp"
        android:background="@android:drawable/alert_light_frame"
        android:ems="10"
        android:inputType="text"
        android:text="QUANTITY"
        app:layout_constraintBottom_toTopOf="@+id/edtComments"
        app:layout_constraintStart_toStartOf="@+id/edtCategory"
        app:layout_constraintTop_toBottomOf="@+id/edtCategory"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/btnMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="34dp"
        android:text="MAINSCREEN"
        app:layout_constraintEnd_toEndOf="@+id/edtComments"
        app:layout_constraintTop_toBottomOf="@+id/edtComments" />

</androidx.constraintlayout.widget.ConstraintLayout>